{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "contour",
  "version": "1.3.0",
  "description": "Structured software work with coding agents.",
  "author": { "name": "Rckov" },
  "homepage": "https://github.com/Rckov/contour",
  "repository": "https://github.com/Rckov/contour",
  "license": "MIT",
  "keywords": ["agent-skills", "software-development", "methodology"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Contour",
        "shortDescription": "Structured AI development",
        "longDescription": "Investigate a project, make changes, and verify the result. Contour combines focused engineering procedures, prepared operations, and Context7 documentation. Working records stay in .contour/.",
        "developerName": "Rckov",
        "category": "Developer Tools",
        "capabilities": ["Read", "Write"],
        "websiteURL": "https://github.com/Rckov/contour",
        "defaultPrompt": ["Use Contour for this development task."],
        "composerIcon": "./skills/contour-development/assets/icon.svg",
        "logo": "./skills/contour-development/assets/icon.svg"
      }
    }
  }
}
